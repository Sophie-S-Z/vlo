# The Supabase project for share links and usage counts (docs/sharing-setup.md).
# Both values are public: the app ships them to each browser, and row level security keeps the tables
# closed. Never put the service key here or anywhere in this repository.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key>

# The WordPress.com app for "Save as a draft on WordPress.com" in Publish (docs/publish-setup.md).
# The id is public. Leave it out, and Publish offers only the copies for each platform.
VITE_WPCOM_CLIENT_ID=<client id>

# "Continue with Google" on the Account page (docs/accounts-setup.md, step 5). Leave it out, and Vlo offers
# only the email code.
VITE_AUTH_GOOGLE=1
